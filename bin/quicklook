#!/usr/bin/python3
import sys, os, subprocess, tempfile
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('GtkSource', '4')
from gi.repository import Gtk, Gdk, GdkPixbuf, GtkSource, GLib

class QuickLook(Gtk.Window):
    def __init__(self, filepath):
        super().__init__(title=os.path.basename(filepath))
        self.filepath = os.path.abspath(filepath)
        self.set_default_size(880, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        
        # Tema Escuro Elegante
        settings = Gtk.Settings.get_default()
        settings.set_property('gtk-application-prefer-dark-theme', True)
        
        # HeaderBar estilo macOS
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title(os.path.basename(self.filepath))
        
        size_str = ''
        if os.path.exists(self.filepath):
            sz = os.path.getsize(self.filepath)
            if sz < 1024:
                size_str = f"{sz} B"
            elif sz < 1024 * 1024:
                size_str = f"{sz/1024:.1f} KB"
            else:
                size_str = f"{sz/(1024*1024):.1f} MB"
        header.set_subtitle(f"{size_str}  •  [Espaço ou Esc para fechar]")
        self.set_titlebar(header)
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(box)
        
        ext = os.path.splitext(self.filepath)[1].lower()
        if os.path.isdir(self.filepath):
            self.render_directory(box)
        elif ext in ('.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp', '.svg', '.ico', '.tiff', '.avif'):
            self.render_image(box, self.filepath)
        elif ext == '.pdf':
            self.render_pdf(box)
        else:
            self.render_text(box)
            
        self.connect('key-press-event', self.on_key_press)
        self.connect('destroy', Gtk.main_quit)
        
    def render_directory(self, box):
        scrolled = Gtk.ScrolledWindow()
        box.pack_start(scrolled, True, True, 0)
        view = Gtk.TextView()
        view.set_editable(False)
        view.set_monospace(True)
        view.set_left_margin(16)
        view.set_top_margin(16)
        try:
            items = os.listdir(self.filepath)
            lines = [f"📁 Pasta: {self.filepath}", f"Total de itens: {len(items)}", "", "Conteúdo:"]
            for item in sorted(items)[:100]:
                is_sub = "📁 " if os.path.isdir(os.path.join(self.filepath, item)) else "📄 "
                lines.append(f"  {is_sub}{item}")
            if len(items) > 100:
                lines.append(f"\n... e mais {len(items)-100} itens.")
            view.get_buffer().set_text("\n".join(lines))
        except Exception as e:
            view.get_buffer().set_text(f"Erro ao listar diretório: {e}")
        scrolled.add(view)
        
    def render_image(self, box, img_path):
        scrolled = Gtk.ScrolledWindow()
        box.pack_start(scrolled, True, True, 0)
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(img_path, 840, 580, True)
            img = Gtk.Image.new_from_pixbuf(pixbuf)
            img.set_alignment(0.5, 0.5)
            scrolled.add(img)
        except Exception as e:
            lbl = Gtk.Label(label=f"Erro ao carregar imagem: {e}")
            box.pack_start(lbl, True, True, 0)
            
    def render_pdf(self, box):
        try:
            tmp_prefix = os.path.join(tempfile.gettempdir(), f"ql_pdf_{os.getpid()}")
            subprocess.run(
                ['pdftoppm', '-png', '-f', '1', '-l', '1', '-scale-to', '840', self.filepath, tmp_prefix],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
            out_img = f"{tmp_prefix}-1.png"
            if os.path.exists(out_img):
                self.render_image(box, out_img)
                try:
                    os.remove(out_img)
                except:
                    pass
                return
        except Exception:
            pass
        self.render_text(box)
        
    def render_text(self, box):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        box.pack_start(scrolled, True, True, 0)
        
        lang_mgr = GtkSource.LanguageManager.get_default()
        lang = lang_mgr.guess_language(self.filepath, None)
        
        source_buffer = GtkSource.Buffer.new_with_language(lang) if lang else GtkSource.Buffer()
        style_mgr = GtkSource.StyleSchemeManager.get_default()
        scheme = style_mgr.get_scheme('Adwaita-dark') or style_mgr.get_scheme('oblivion') or style_mgr.get_scheme('classic')
        if scheme:
            source_buffer.set_style_scheme(scheme)
            
        try:
            with open(self.filepath, 'r', encoding='utf-8', errors='ignore') as f:
                content = f.read(200000)
                source_buffer.set_text(content)
        except Exception as e:
            source_buffer.set_text(f"Erro ao ler arquivo: {e}")
            
        view = GtkSource.View.new_with_buffer(source_buffer)
        view.set_editable(False)
        view.set_cursor_visible(False)
        view.set_show_line_numbers(True)
        view.set_monospace(True)
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.set_left_margin(14)
        view.set_right_margin(14)
        view.set_top_margin(10)
        view.set_bottom_margin(10)
        scrolled.add(view)
        
    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_space, Gdk.KEY_q, Gdk.KEY_Q):
            Gtk.main_quit()
            return True
        return False

if __name__ == '__main__':
    if len(sys.argv) > 1 and os.path.exists(sys.argv[1]):
        app = QuickLook(sys.argv[1])
        app.show_all()
        Gtk.main()
    else:
        print('Uso: quicklook <caminho_do_arquivo>')
